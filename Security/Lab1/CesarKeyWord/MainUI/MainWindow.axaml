<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="MainUI.MainWindow"
        Title="MainUI">

    <Grid ColumnDefinitions="2*, Auto, *"
          Background="White">

      
        <Grid Grid.Column="0" RowDefinitions="*, Auto">

            <Border Grid.Row="0">
                <ContentControl x:Name="StageContent"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                    <TextBlock x:Name="EncodedWord"
                               FontSize="50"
                               Foreground="Black"
                               FontFamily="fonts:Inter#Inter"
                               Text="Test"/>
                </ContentControl>
            </Border>

           
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="50"
                        Margin="0,0,0,20">

                <ComboBox x:Name="Modes">
                    <ComboBoxItem x:Name="EncryptMode">Закодировать</ComboBoxItem>
                    <ComboBoxItem x:Name="DecryptMode">Расшифровать</ComboBoxItem>
                </ComboBox>

                <Button x:Name="BackButton" Background="Violet" Padding="20,8">
                    <TextBlock FontSize="14" Text="Назад"/>
                </Button>

                <Button x:Name="NextButton" Background="Violet" Padding="20,8">
                    <TextBlock FontSize="14" Text="Далее"/>
                </Button>

                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            >
                    <TextBlock Foreground="Black" Margin="32 10">
                        Ключ
                    </TextBlock>
                    <NumericUpDown x:Name="CesarKey"
                               Minimum="1"
                               Maximum="9"
                               ParsingNumberStyle="Integer"
                               />
                    <TextBlock Foreground="Black" Margin="32 10">
                        ручной ввод
                    </TextBlock>
                <CheckBox x:Name="UseKey" Background="Wheat"/>
                </StackPanel>
                
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      Background="Gray"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

       
        <Border Grid.Column="2" Background="#F0F0F0">
    <DockPanel Margin="20">
        <UniformGrid x:Name="MatrixSquare" 
                     DockPanel.Dock="Bottom"
                     Rows="4" Columns="4"
                     Margin="0,10,0,0"/>
        
        <ListBox x:Name="StagesList"
                 FontFamily="fonts:Inter#Inter"
                 FontSize="16"/>
    </DockPanel>
</Border>
    </Grid>
</Window>